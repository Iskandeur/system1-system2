# Copy to .env and fill values.
# Never commit real keys.

# Default pair (System 1 = TypeSafe Jev, System 2 = Claude Fable) only needs an OpenRouter key.
OPENROUTER_API_KEY=

# Hybrid routing threshold (0..1).
# If System 1 confidence < threshold, we escalate to System 2.
# Default chosen from this repo's threshold sweep (best cost/quality tradeoff on the demo dataset).
HYBRID_CONFIDENCE_THRESHOLD=0.40

# ---- Bring your own models (all optional; see README "Bring your own models") ----
# Presets: jev, typesafe, openrouter, openai, groq, together, deepseek, mistral, ollama, lmstudio,
#          vllm, openai-compatible, anthropic
#
# System 1 (fast, answers first, must produce a confidence):
# S1_PROVIDER=openrouter
# S1_MODEL=meta-llama/llama-3.1-8b-instruct
# S1_BASE_URL=            # override the preset URL (any OpenAI-compatible /v1)
# S1_API_KEY_ENV=         # name of the env var holding the key (default depends on preset)
# S1_HEADERS={"X-Title":"system1-system2"}
# S1_PARAMS={"temperature":0}
# S1_CONFIDENCE=auto      # auto | logprobs | self | none
# S1_JSON_MODE=json_schema  # json_schema | json_object | none
# S1_PRICE_INPUT_PER_M=   # USD per 1M input tokens, for providers that do not report cost
# S1_PRICE_OUTPUT_PER_M=
#
# System 2 (slower, called on escalation): same variables with the S2_ prefix.
# S2_PROVIDER=anthropic
# S2_MODEL=claude-fable-5.1
# ANTHROPIC_API_KEY=
