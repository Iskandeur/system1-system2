# Copy to .env and fill values. Never commit real keys.

# The default pair (System 1 = TypeSafe Jev, System 2 = GPT-5.2, both through OpenRouter) needs one key:
OPENROUTER_API_KEY=

# Escalation threshold used by run-eval when you pass --threshold; otherwise the threshold is
# chosen on a tuning half of the items (see README, "Method").
# HYBRID_CONFIDENCE_THRESHOLD=0.7

# Dataset: massive-en (default), massive-fr, github-issues, massive-en-injected, or a path to a JSON file.
# EVAL_DATASET=massive-en

# ---- Bring your own models (all optional; see README "Bring your own models") ----
# Presets: jev, typesafe, openrouter, openai, groq, together, deepseek, mistral, ollama, lmstudio,
#          vllm, openai-compatible, anthropic
#
# System 1 (fast, answers first, must produce a confidence):
# S1_PROVIDER=openrouter
# S1_MODEL=openai/gpt-4o-mini
# S1_CONFIDENCE=logprobs    # auto | logprobs | self | none (chat models only)
# S1_JSON_MODE=json_schema  # json_schema | json_object | none
# S1_BASE_URL=              # override the preset URL (any OpenAI-compatible /v1)
# S1_API_KEY_ENV=           # name of the env var holding the key (default depends on preset)
# S1_HEADERS={"X-Title":"system1-system2"}
# S1_PARAMS={"temperature":0}
# S1_PRICE_INPUT_PER_M=     # USD per 1M tokens, for endpoints that report tokens but no cost
# S1_PRICE_OUTPUT_PER_M=    # (data/prices.json already covers the models used in the README)
#
# System 2 (slower, called on escalation): same variables with the S2_ prefix.
# S2_PROVIDER=openai
# S2_MODEL=gpt-5.2
# OPENAI_API_KEY=
#
# Anthropic-compatible endpoints honour the SDK's variables, so a proxy that sets
# ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN works with S2_PROVIDER=anthropic and no other flag:
# S2_PROVIDER=anthropic
# S2_MODEL=claude-fable-5.1
# ANTHROPIC_API_KEY=
